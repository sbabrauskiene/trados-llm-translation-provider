<?xml version="1.0" encoding="utf-8"?>
<PluginPackage xmlns="http://www.sdl.com/Plugins/PluginPackage/1.0">
  <PlugInName>LLM Translation Provider</PlugInName>
  <Version>1.0.0.0</Version>
  <Description>Personal LLM-backed translation provider with TBX termbase enforcement.</Description>
  <Author>Svetlana</Author>
  <!--
    Targets the currently installed base Trados Studio 2022 (17.0) release directly - see the
    project plan for why updating to SR2 is not required for this plugin. If you later update
    Studio, there is no need to change this value: the interfaces used here are stable across
    17.x, so a wide maxversion keeps the plugin working through SR1/SR2 as well.
  -->
  <RequiredProduct name="TradosStudio" minversion="17.0" maxversion="17.9" />
</PluginPackage>
